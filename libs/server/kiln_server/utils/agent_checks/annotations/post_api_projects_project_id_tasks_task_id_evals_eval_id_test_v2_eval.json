{
  "method": "post",
  "path": "/api/projects/{project_id}/tasks/{task_id}/evals/{eval_id}/test_v2_eval",
  "agent_policy": {
    "permission": "deny",
    "requires_approval": false
  },
  "request_body": {
    "required": true,
    "content_type": "application/json",
    "schema": {
      "properties": {
        "properties": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "$ref": "#/$defs/LlmJudgeProperties"
                },
                {
                  "$ref": "#/$defs/ExactMatchProperties"
                },
                {
                  "$ref": "#/$defs/PatternMatchProperties"
                },
                {
                  "$ref": "#/$defs/SetCheckProperties"
                },
                {
                  "$ref": "#/$defs/ToolCallCheckProperties"
                },
                {
                  "$ref": "#/$defs/ContainsProperties"
                },
                {
                  "$ref": "#/$defs/StepCountCheckProperties"
                },
                {
                  "$ref": "#/$defs/CodeEvalProperties"
                }
              ],
              "discriminator": {
                "propertyName": "type",
                "mapping": {
                  "code_eval": "#/$defs/CodeEvalProperties",
                  "contains": "#/$defs/ContainsProperties",
                  "exact_match": "#/$defs/ExactMatchProperties",
                  "llm_judge": "#/$defs/LlmJudgeProperties",
                  "pattern_match": "#/$defs/PatternMatchProperties",
                  "set_check": "#/$defs/SetCheckProperties",
                  "step_count_check": "#/$defs/StepCountCheckProperties",
                  "tool_call_check": "#/$defs/ToolCallCheckProperties"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "title": "Properties",
          "description": "The V2 eval config properties to test. Required unless llm_judge_builder_input is set."
        },
        "eval_input": {
          "properties": {
            "final_message": {
              "type": "string",
              "title": "Final Message",
              "description": "The final model output (task output text)."
            },
            "trace": {
              "anyOf": [
                {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Trace",
              "description": "The full conversation trace, if available."
            },
            "reference_data": {
              "anyOf": [
                {
                  "additionalProperties": {},
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Reference Data",
              "description": "Ground-truth data for the item being evaluated, keyed by reference name. Taken from EvalInput.reference for an EvalInput-backed item; for a TaskRun-backed dataset item it is the item's own stored output under the key 'reference_answer', since that output is the curated answer. None when a TaskRun is scored as itself (judge calibration), where the item and the scored run are the same record."
            },
            "task_input": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Task Input",
              "description": "The original task input text."
            }
          },
          "type": "object",
          "required": [
            "final_message"
          ],
          "title": "EvalTaskInput",
          "description": "The runtime data bundle passed to V2 evaluators.\n\nAssembled by the eval runner from the item being evaluated and the task run that\nwas scored. The item is either an EvalInput or a TaskRun drawn from the dataset;\nwhich one it is determines where `reference_data` and `task_input` come from."
        },
        "llm_judge_builder_input": {
          "anyOf": [
            {
              "properties": {
                "model_name": {
                  "type": "string",
                  "title": "Model Name",
                  "description": "The LLM model to use as judge."
                },
                "provider": {
                  "type": "string",
                  "enum": [
                    "openai",
                    "groq",
                    "amazon_bedrock",
                    "ollama",
                    "openrouter",
                    "fireworks_ai",
                    "kiln_fine_tune",
                    "kiln_custom_registry",
                    "openai_compatible",
                    "anthropic",
                    "gemini_api",
                    "azure_openai",
                    "huggingface",
                    "vertex",
                    "together_ai",
                    "siliconflow_cn",
                    "cerebras",
                    "docker_model_runner",
                    "featherless_ai"
                  ],
                  "title": "ModelProviderName",
                  "description": "Enumeration of supported AI model providers."
                },
                "g_eval": {
                  "type": "boolean",
                  "title": "G Eval",
                  "description": "Whether to use G-Eval logprob scoring."
                },
                "judge_prompt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Judge Prompt",
                  "description": "Override the judge prompt template. If unset, the server assembles a rich default from the eval's task and spec."
                },
                "system_prompt": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "System Prompt",
                  "description": "Override the judge system prompt. Defaults to 'You are an evaluator.'"
                },
                "judge_instructions": {
                  "anyOf": [
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Judge Instructions",
                  "description": "User-written evaluation steps, bound to {{ judge_instructions }} when the judge prompt is rendered. Used by evals with no spec or template to derive default steps from."
                }
              },
              "type": "object",
              "required": [
                "model_name",
                "provider",
                "g_eval"
              ],
              "title": "LlmJudgeBuilderInput",
              "description": "Shared fields for llm_judge: model, provider, g_eval."
            },
            {
              "type": "null"
            }
          ],
          "description": "Builder input for llm_judge; when set, the server bakes the full properties from the eval's output_scores."
        }
      },
      "type": "object",
      "required": [
        "eval_input"
      ],
      "title": "TestV2EvalRequest",
      "description": "Request to test-run a V2 eval config without persisting.",
      "$defs": {
        "CodeEvalProperties": {
          "properties": {
            "type": {
              "type": "string",
              "const": "code_eval",
              "title": "Type",
              "default": "code_eval"
            },
            "code": {
              "type": "string",
              "title": "Code"
            },
            "reference_keys": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Reference Keys",
              "default": []
            },
            "timeout_seconds": {
              "type": "integer",
              "maximum": 300.0,
              "minimum": 1.0,
              "title": "Timeout Seconds",
              "default": 180
            },
            "tool_allowlist": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Tool Allowlist",
              "description": "Explicit per-tool allowlist of tools the scorer code may call."
            }
          },
          "type": "object",
          "required": [
            "code"
          ],
          "title": "CodeEvalProperties"
        },
        "ContainsProperties": {
          "properties": {
            "type": {
              "type": "string",
              "const": "contains",
              "title": "Type",
              "default": "contains"
            },
            "value_expression": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value Expression"
            },
            "substring": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Substring"
            },
            "reference_key": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Reference Key"
            },
            "case_sensitive": {
              "type": "boolean",
              "title": "Case Sensitive",
              "default": true
            },
            "mode": {
              "type": "string",
              "enum": [
                "must_contain",
                "must_not_contain"
              ],
              "title": "Mode",
              "default": "must_contain"
            }
          },
          "type": "object",
          "title": "ContainsProperties"
        },
        "ExactMatchProperties": {
          "properties": {
            "type": {
              "type": "string",
              "const": "exact_match",
              "title": "Type",
              "default": "exact_match"
            },
            "value_expression": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value Expression"
            },
            "expected_value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Expected Value"
            },
            "reference_key": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Reference Key"
            },
            "case_sensitive": {
              "type": "boolean",
              "title": "Case Sensitive",
              "default": true
            }
          },
          "type": "object",
          "title": "ExactMatchProperties"
        },
        "LlmJudgeProperties": {
          "properties": {
            "type": {
              "type": "string",
              "const": "llm_judge",
              "title": "Type",
              "default": "llm_judge"
            },
            "model_name": {
              "type": "string",
              "title": "Model Name"
            },
            "model_provider": {
              "type": "string",
              "title": "Model Provider"
            },
            "system_prompt": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "System Prompt"
            },
            "prompt_template": {
              "type": "string",
              "title": "Prompt Template"
            },
            "reference_keys": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "title": "Reference Keys",
              "default": []
            },
            "thinking_instruction": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Thinking Instruction"
            },
            "g_eval": {
              "type": "boolean",
              "title": "G Eval",
              "default": false
            },
            "judge_instructions": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Judge Instructions"
            }
          },
          "type": "object",
          "required": [
            "model_name",
            "model_provider",
            "prompt_template"
          ],
          "title": "LlmJudgeProperties"
        },
        "PatternMatchProperties": {
          "properties": {
            "type": {
              "type": "string",
              "const": "pattern_match",
              "title": "Type",
              "default": "pattern_match"
            },
            "value_expression": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value Expression"
            },
            "pattern": {
              "type": "string",
              "title": "Pattern"
            },
            "mode": {
              "type": "string",
              "enum": [
                "must_match",
                "must_not_match"
              ],
              "title": "Mode",
              "default": "must_match"
            }
          },
          "type": "object",
          "required": [
            "pattern"
          ],
          "title": "PatternMatchProperties"
        },
        "SetCheckProperties": {
          "properties": {
            "type": {
              "type": "string",
              "const": "set_check",
              "title": "Type",
              "default": "set_check"
            },
            "value_expression": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value Expression"
            },
            "expected_set": {
              "anyOf": [
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Expected Set"
            },
            "reference_key": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "title": "Reference Key"
            },
            "mode": {
              "type": "string",
              "enum": [
                "subset",
                "superset",
                "equal"
              ],
              "title": "Mode"
            }
          },
          "type": "object",
          "required": [
            "mode"
          ],
          "title": "SetCheckProperties"
        },
        "StepCountCheckProperties": {
          "properties": {
            "type": {
              "type": "string",
              "const": "step_count_check",
              "title": "Type",
              "default": "step_count_check"
            },
            "count_type": {
              "type": "string",
              "enum": [
                "tool_calls",
                "model_responses",
                "turns"
              ],
              "title": "Count Type"
            },
            "min_count": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Min Count"
            },
            "max_count": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Count"
            }
          },
          "type": "object",
          "required": [
            "count_type"
          ],
          "title": "StepCountCheckProperties"
        },
        "ToolCallCheckProperties": {
          "properties": {
            "type": {
              "type": "string",
              "const": "tool_call_check",
              "title": "Type",
              "default": "tool_call_check"
            },
            "expected_tools": {
              "items": {
                "properties": {
                  "tool_name": {
                    "type": "string",
                    "title": "Tool Name"
                  },
                  "expected_args": {
                    "anyOf": [
                      {
                        "additionalProperties": {
                          "properties": {
                            "value": {},
                            "match_mode": {
                              "type": "string",
                              "enum": [
                                "exact",
                                "contains",
                                "regex"
                              ],
                              "title": "Match Mode",
                              "default": "exact"
                            }
                          },
                          "type": "object",
                          "required": [
                            "value"
                          ],
                          "title": "ArgMatch"
                        },
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Expected Args"
                  }
                },
                "type": "object",
                "required": [
                  "tool_name"
                ],
                "title": "ToolCallSpec"
              },
              "type": "array",
              "minItems": 1,
              "title": "Expected Tools"
            },
            "match_mode": {
              "type": "string",
              "enum": [
                "any",
                "all",
                "ordered",
                "never"
              ],
              "title": "Match Mode",
              "default": "all"
            },
            "on_unexpected_tools": {
              "type": "string",
              "enum": [
                "ignore",
                "fail"
              ],
              "title": "On Unexpected Tools",
              "default": "ignore"
            }
          },
          "type": "object",
          "required": [
            "expected_tools"
          ],
          "title": "ToolCallCheckProperties"
        }
      }
    }
  },
  "parameters": {
    "path": {
      "project_id": {
        "type": "string",
        "description": "The unique identifier of the project.",
        "title": "Project Id"
      },
      "task_id": {
        "type": "string",
        "description": "The unique identifier of the task within the project.",
        "title": "Task Id"
      },
      "eval_id": {
        "type": "string",
        "description": "The unique identifier of the eval.",
        "title": "Eval Id"
      }
    },
    "query": {}
  }
}
