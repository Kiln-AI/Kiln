{
  "method": "get",
  "path": "/api/jobs",
  "agent_policy": {
    "permission": "allow",
    "requires_approval": false
  },
  "request_body": null,
  "parameters": {
    "path": {},
    "query": {
      "status": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "paused",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "BackgroundJobStatus"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by job status.",
        "title": "Status"
      },
      "type": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by job type.",
        "title": "Type"
      },
      "project_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "Filter by project id.",
        "title": "Project Id"
      },
      "since": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time"
          },
          {
            "type": "null"
          }
        ],
        "description": "Only jobs created at or after this ISO-8601 time.",
        "title": "Since"
      },
      "limit": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "description": "Maximum number of jobs to return.",
        "title": "Limit"
      }
    }
  }
}
